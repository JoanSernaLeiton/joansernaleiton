---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { SITE } from "@config";
import { CERTIFICATIONS, EXPERIENCE, MENTORING, TALKS } from "../data/profile";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Experience, certifications and talks of Joan Serna, Sr. Software Engineer, Tech Lead and AWS Solutions Architect."
>
  <Header activeNav="about" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="intro" aria-labelledby="about-title">
      <img
        src="/assets/joan.jpg"
        class="avatar"
        width="640"
        height="640"
        alt="Portrait of Joan Serna"
      />
      <div>
        <p class="eyebrow">About</p>
        <h1 id="about-title">Joan Serna</h1>
        <p class="lead">{SITE.desc}</p>
      </div>
    </section>

    <section aria-labelledby="exp-title">
      <h2 id="exp-title">Experience</h2>
      <ol class="timeline">
        {
          EXPERIENCE.map(job => (
            <li class="job">
              <div class="job-head">
                <h3>
                  {job.role} <span class="at">· {job.company}</span>
                </h3>
                <p class="meta">
                  <span class="period">{job.period}</span>
                  <span>{job.location}</span>
                </p>
              </div>
              <ul class="highlights">
                {job.highlights.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="cert-title">
      <h2 id="cert-title">Certifications</h2>
      <ul class="cards">
        {
          CERTIFICATIONS.map(cert => (
            <li class="card">
              <p class="card-title">{cert.name}</p>
              <p class="card-meta">{cert.issuer}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="talks-title">
      <h2 id="talks-title">Talks &amp; mentoring</h2>
      <ol class="timeline">
        {
          [...TALKS, ...MENTORING].map(talk => (
            <li class="job">
              <div class="job-head">
                <h3>{talk.title}</h3>
                <p class="meta">
                  <span class="period">{talk.date}</span>
                  <span>{talk.event}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-8;
  }
  .intro {
    @apply grid items-center gap-6 px-0 pb-6 pt-8 sm:grid-cols-[10rem_1fr] sm:gap-8;
  }
  .avatar {
    @apply mx-auto aspect-square w-32 rounded-full border border-skin-line bg-skin-card sm:w-40;
  }
  .eyebrow {
    @apply mb-2 font-mono text-sm font-medium uppercase tracking-wider text-skin-accent;
  }
  .intro h1 {
    @apply mb-3 text-4xl font-bold;
  }
  .lead {
    @apply text-skin-muted;
  }
  section:not(.intro) {
    @apply px-0 pt-10;
  }
  h2 {
    @apply mb-6 text-2xl font-semibold;
  }
  .timeline {
    @apply ml-2 space-y-8 border-l border-skin-line;
  }
  .job {
    @apply relative pl-6;
  }
  .job::before {
    content: "";
    @apply absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-skin-accent;
  }
  .job h3 {
    @apply text-lg font-semibold;
  }
  .at {
    @apply text-skin-accent;
  }
  .meta {
    @apply mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-skin-muted;
  }
  .period {
    @apply rounded-full border border-skin-line bg-skin-card px-2.5 py-0.5 font-mono text-xs;
  }
  .highlights {
    @apply mt-3 list-disc space-y-1.5 pl-5 marker:text-skin-muted;
  }
  .cards {
    @apply grid gap-4 sm:grid-cols-2;
  }
  .card {
    @apply rounded-lg border border-skin-line bg-skin-card p-4;
  }
  .card-title {
    @apply font-semibold;
  }
  .card-meta {
    @apply mt-1 text-sm text-skin-muted;
  }
</style>
