---
export interface Props {
  name: string;
  url: string;
  status: string;
  tagline: string;
  description: string;
  tags: string[];
  level?: 2 | 3;
}

const {
  name,
  url,
  status,
  tagline,
  description,
  tags,
  level = 3,
} = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<li class="project">
  <div class="top">
    <Heading>
      <a href={url} target="_blank" rel="noopener noreferrer">
        {name}<span class="sr-only"> (opens in a new tab)</span>
        <span aria-hidden="true"> ↗</span>
      </a>
    </Heading>
    <span class="status">{status}</span>
  </div>
  <p class="tagline">{tagline}</p>
  <p class="desc">{description}</p>
  <ul class="chips">
    {tags.map(tag => <li>{tag}</li>)}
  </ul>
</li>

<style>
  .project {
    @apply rounded-lg border border-skin-line bg-skin-card p-5;
  }
  .top {
    @apply flex items-center justify-between gap-3;
  }
  .top :global(h2),
  .top :global(h3) {
    @apply text-xl font-semibold;
  }
  .top :global(a) {
    @apply underline decoration-skin-accent/60 underline-offset-4 hover:text-skin-accent;
  }
  .status {
    @apply rounded-full border border-skin-line px-2.5 py-0.5 font-mono text-xs text-skin-accent;
  }
  .tagline {
    @apply mt-1 font-medium;
  }
  .desc {
    @apply mt-2 text-skin-muted;
  }
  .chips {
    @apply mt-4 flex flex-wrap gap-2;
  }
  .chips li {
    @apply rounded-full border border-skin-strong px-3 py-1 text-sm;
  }
</style>
