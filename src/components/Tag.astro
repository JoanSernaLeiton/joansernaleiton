---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class={`inline-block ${size === "sm" ? "my-1" : "m-1"}`}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`tag ${size === "sm" ? "text-sm" : "text-base"}`}
  >
    <span class="hash" aria-hidden="true">#</span>{tag}
  </a>
</li>

<style>
  .tag {
    @apply inline-flex min-h-[2rem] items-center rounded-full border border-skin-line bg-skin-card px-3 py-1 font-mono no-underline transition-colors hover:border-skin-accent hover:text-skin-accent;
  }
  .hash {
    @apply mr-0.5 text-skin-muted;
  }
</style>
